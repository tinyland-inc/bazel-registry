{
  "name": "@tummycrypt/bazel-registry",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "validate": "npm run test:aspect-rules-ts-versions && node scripts/validate-registry.mjs",
    "test:aspect-rules-ts-versions": "node --test scripts/validate-aspect-rules-ts-versions.test.mjs",
    "smoke:resolve": "node scripts/smoke-active-registry.mjs",
    "smoke:stage1-consumer": "node scripts/smoke-stage1-consumer-targets.mjs",
    "smoke:scheduling-kit-only": "node scripts/smoke-stage1-consumer-targets.mjs --scenario=scheduling-kit-only",
    "smoke:scheduling-bridge-only": "node scripts/smoke-stage1-consumer-targets.mjs --scenario=scheduling-bridge-only",
    "smoke:tempo-store-only": "node scripts/smoke-stage1-consumer-targets.mjs --scenario=tempo-store-only"
  },
  "bazelEstate": {
    "version": "8.2.1"
  }
}
